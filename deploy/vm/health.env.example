# Read by the health check timer. Copy to /etc/home-ops/health.env and fill in.
# Services to request, separated by spaces.
HEALTH_URLS=https://home.example.com/
# Certificates to check for expiry, as host:port.
HEALTH_TLS=home.example.com:443
# Warn when a certificate has fewer days left than this.
HEALTH_WARN_DAYS=14
# Optional. A URL that receives a JSON POST when a check fails, for example an ntfy topic.
ALERT_WEBHOOK=
