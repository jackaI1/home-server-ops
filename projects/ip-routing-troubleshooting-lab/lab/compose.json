      },
      "volumes": [
        "./generated/pe1:/lab-config:ro",
        "./boot.sh:/lab-boot.sh:ro"
      ],
      "entrypoint": [
        "/bin/sh",
        "/lab-boot.sh"
      ],
      "restart": "no",
      "privileged": true,
      "mem_limit": "128m",
      "pids_limit": 100,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "2m",
          "max-file": "1"
        }
      },
      "networks": {
        "west": {
          "ipv4_address": "10.10.1.3",
          "interface_name": "access"
        },
        "core_west": {
          "ipv4_address": "10.10.2.2",
          "interface_name": "core1"
        }
      }
    },
