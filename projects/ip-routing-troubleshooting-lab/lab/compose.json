{
  "services": {
    "ce1": {
      "image": "quay.io/frrouting/frr:10.2.1",
      "hostname": "ce1",
      "cap_add": [
        "NET_ADMIN",
        "NET_RAW",
        "SYS_ADMIN"
      ],
      "sysctls": {
        "net.ipv4.ip_forward": "1",
        "net.ipv4.conf.all.rp_filter": "0"
      },
      "volumes": [
        "./generated/ce1:/lab-config:ro",
        "./boot.sh:/lab-boot.sh:ro"
      ],
      "entrypoint": [
        "/bin/sh",
        "/lab-boot.sh"
      ],
      "restart": "no",
      "privileged": false,
      "mem_limit": "128m",
      "pids_limit": 100,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "2m",
          "max-file": "1"
        }
      },
      "networks": {
        "west": {
          "ipv4_address": "10.10.1.2",
          "interface_name": "access"
        }
      }
    },
    "pe1": {
      "image": "quay.io/frrouting/frr:10.2.1",
      "hostname": "pe1",
      "cap_add": [
        "NET_ADMIN",
        "NET_RAW",
        "SYS_ADMIN"
      ],
